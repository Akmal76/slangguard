# Copy this file to .env and fill in the values. .env is ignored by git, never commit it.
# Used with: uv run --env-file .env python -m src.pipelines.flow ...

# MLflow tracking and Model Registry, hosted on DagsHub.
MLFLOW_TRACKING_URI=https://dagshub.com/Akmal76/slangguard-data.mlflow
MLFLOW_TRACKING_USERNAME=Akmal76
# The DagsHub token (the same one as in .dvc/config.local).
MLFLOW_TRACKING_PASSWORD=
